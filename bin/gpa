#!/usr/bin/env bash
# Tool/intent: gpa keeps a collection of checkouts up to date with a single
#   command and a readable summary. Its shallow search paths reflect the
#   current personal workflow; they are defaults to revisit as needs change.
# Invocation: execute gpa [-a|--all] [-v|--verbose], including -av or -va;
#   -h/--help prints usage. Called on demand by a user or by gpa over SSH.
#   Execute rather than source: this script changes shell state and may exit.
# Inputs: local mode searches HOME and HOME/repos, independent of cwd.
#   Remote mode reads GPA_HOSTS_FILE when nonempty, otherwise
#   ${XDG_CONFIG_HOME:-$HOME/.config}/gpa/hosts. Hosts are SSH destinations;
#   the file is data, not shell code. GPA_COLOR=always/never overrides automatic
#   terminal color detection; nonempty NO_COLOR takes precedence and disables it.
#   GPA_PROGRESS=always/never overrides automatic terminal progress detection.
# Interactions: install.sh links this executable into ~/.local/bin; the user
#   manages PATH, host configuration, and Git/SSH authentication separately.
#   Remote hosts need gpa on their noninteractive PATH. Forward -v and the
#   caller's color and progress choices; each host uses its own HOME and Git
#   configuration.
# Effects: git pull --ff-only contacts upstreams and can change Git state and
#   working trees. Existing hooks, helpers, and autostash settings still apply.
#   Repeated runs pull again; there is no rollback of earlier successful pulls.
#   Git terminal prompts are disabled, but SSH/helpers may still prompt or wait.
# Output/status: results and summaries go to stdout, argument/configuration
#   errors and host failure notices to stderr. Pull diagnostics are captured
#   in results. Remote output has destination blocks and a host completion
#   footer naming destinations whose SSH/remote command returned nonzero.
#   Exit 0 includes skips; 1 means a pull/SSH/remote command failed;
#   2 means invalid arguments or local host configuration. Failures do not stop
#   later repositories/hosts. Remote mode has no additional local update.
# Requires: Bash, Git, sed; SSH locally and env remotely for -a.
#   The current implementation is tested on Linux and shared by zsh and fish.

# Parse the entire implementation before running pulls, so updating this
# checkout cannot change code halfway through the current invocation.
main() {

# Failure statuses are collected explicitly rather than using errexit;
# arithmetic increments can also return nonzero during normal execution.
# Use the C locale because the diagnostic filters below match English text.
export LC_ALL=C

declare verbose=0 all_hosts=0 arg flags
for arg in "$@"; do
    case "$arg" in
        --help|-h)
            printf '%s\n' 'Usage: gpa [-a|--all] [-v|--verbose]' \
                'Pull repositories under ~ and ~/repos with --ff-only.' \
                '-a: run on hosts from ${XDG_CONFIG_HOME:-$HOME/.config}/gpa/hosts.' \
                'GPA_HOSTS_FILE overrides the hosts file. Combine flags as -av.' \
                '-v: include branch and Git details, including on remote hosts.'
            return 0
            ;;
        --verbose) verbose=1 ;;
        --all) all_hosts=1 ;;
        -[av]*)
            flags=${arg#-}
            if [[ "$flags" == *[!av]* ]]; then
                printf '%s\n' "Usage: gpa [-a|--all] [-v|--verbose]" >&2
                exit 2
            fi
            [[ "$flags" == *a* ]] && all_hosts=1
            [[ "$flags" == *v* ]] && verbose=1
            ;;
        *)
            printf '%s\n' "Usage: gpa [-a|--all] [-v|--verbose]" >&2
            exit 2
            ;;
    esac
done

# SSH output is piped for indentation and normally has no terminal. Let the
# dispatcher pass display choices without requesting a PTY, preserving separate
# stdout/stderr and noninteractive Git. NO_COLOR disables colors only.
declare color_red='' color_yellow='' color_reset=''
if [[ -z "${NO_COLOR:-}" && "${GPA_COLOR:-auto}" != never ]] &&
    { [[ "${GPA_COLOR:-auto}" == always ]] || [[ -t 1 && "${TERM:-dumb}" != dumb ]]; }; then
    color_red=$'\e[31m' color_yellow=$'\e[33m' color_reset=$'\e[0m'
fi

# Progress is independent of color: NO_COLOR must not hide a slow pull.
declare progress=0
if [[ "${GPA_PROGRESS:-auto}" != never ]] &&
    { [[ "${GPA_PROGRESS:-auto}" == always ]] || [[ -t 1 ]]; }; then
    progress=1
fi

if (( all_hosts )); then
    declare host remote_status=0 host_status host_index=0 completed=0 attention_hosts=''
    # Use only fixed command strings, never host data or environment values as
    # shell source. Forward color and verbosity, but not recursive dispatch (-a).
    # Label destinations locally so a failed connection still has a heading.
    declare remote_command='env GPA_COLOR=never'
    [[ -n "$color_red" ]] && remote_command='env GPA_COLOR=always'
    # Insert only literal policy values into the fixed remote command.
    if (( progress )); then
        remote_command+=' GPA_PROGRESS=always gpa'
    else
        remote_command+=' GPA_PROGRESS=never gpa'
    fi
    (( verbose )) && remote_command+=' -v'
    declare hosts_file=${GPA_HOSTS_FILE:-${XDG_CONFIG_HOME:-$HOME/.config}/gpa/hosts}
    declare -a hosts=()
    if [[ ! -r "$hosts_file" ]]; then
        printf 'gpa: cannot read hosts file: %s\n' "$hosts_file" >&2
        return 2
    fi
    # Validate the entire file first so a bad later entry does not leave an
    # already-started update across earlier hosts. This intentionally narrow
    # format excludes leading SSH options and shell syntax; aliases can cover
    # destinations requiring more elaborate SSH configuration.
    while IFS= read -r host || [[ -n "$host" ]]; do
        [[ "$host" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ ! "$host" =~ ^[a-zA-Z0-9_][a-zA-Z0-9_.@:-]*$ ]]; then
            printf 'gpa: invalid host in %s: %s\n' "$hosts_file" "$host" >&2
            return 2
        fi
        hosts+=("$host")
    done < "$hosts_file"
    if (( ${#hosts[@]} == 0 )); then
        printf 'gpa: no hosts configured in %s\n' "$hosts_file" >&2
        return 2
    fi
    # Remote progress uses newline-delimited records so read can forward a
    # pending FETCH before the pull finishes. Render only that record without
    # a newline; a subsequent clear-line prefix replaces it with the result.
    # Older hosts still stream ordinary lines. Preserve EOF diagnostics and
    # finish an outstanding progress line if SSH disconnects mid-pull.
    __gpa_indent() {
        local line pending=0 clear=$'\r\033[K'
        while IFS= read -r line || [[ -n "$line" ]]; do
            if (( progress )) && [[ "$line" == "$clear"* ]]; then
                line=${line#"$clear"}
                printf '\r\033[K    %s' "$line"
                if [[ "$line" == '[FETCH  ] '* ]]; then
                    pending=1
                else
                    printf '\n'
                    pending=0
                fi
            else
                (( pending )) && printf '\n'
                pending=0
                if [[ -n "$line" ]]; then
                    printf '    %s\n' "$line"
                else
                    printf '\n'
                fi
            fi
        done
        (( pending )) && printf '\n'
        return 0
    }

    # Stream output within host blocks so slow pulls remain visible. Do not
    # infer repository counts from remote text: older gpa versions may format
    # results differently, and SSH failures may leave an incomplete summary.
    # Sequential dispatch keeps blocks together; SSH owns timeout policy.
    for host in "${hosts[@]}"; do
        (( host_index++ ))
        (( host_index > 1 )) && printf '\n'
        printf '[%-7s] %s  (%d/%d)\n' "HOST" "$host" "$host_index" "${#hosts[@]}"
        # Keep diagnostics on stderr and wait for its formatter before the
        # next host. Read SSH's status, not the stdout formatter's exit status.
        {
            exec 3> >(__gpa_indent >&2)
            formatter_pid=$!
            ssh -q "$host" "$remote_command" 2>&3 3>&-
            host_status=$?
            exec 3>&-
            wait "$formatter_pid"
            exit "$host_status"
        } | __gpa_indent
        host_status=${PIPESTATUS[0]}
        if (( host_status == 0 )); then
            (( completed++ ))
        else
            attention_hosts+="${attention_hosts:+, }$host"
            printf '    [%-7s] %s  ssh or remote gpa failed (exit %d)\n' "FAILED" "$host" "$host_status"
            printf '    gpa: failed on %s\n' "$host" >&2
            remote_status=1
        fi
    done
    # This footer tracks command completion, not repository totals or warning
    # counts. A nonzero exit may follow some successful pulls; name the hosts
    # to revisit without implying that all their repositories failed.
    printf '\ngpa hosts: %d/%d completed\n' "$completed" "${#hosts[@]}"
    if [[ -n "$attention_hosts" ]]; then
        printf '    %sNeeds attention: %s%s\n' "$color_red" "$attention_hosts" "$color_reset"
    fi
    return "$remote_status"
fi

declare total=0 updated=0 current=0 skipped=0 failed=0 warnings=0
declare repo label branch pull_output pull_status before after details line
declare repo_status reason max_label_len=24
declare forced_update autostash
declare -a repos

# Pull $1 and print its result, updating main's counters and scratch variables
# through Bash's dynamic scope. The aggregate failed count, not this helper's
# return value, determines the command status. Captured output supplies details
# in verbose mode and failure diagnostics in either mode.
__gpa_pull() {
    repo="$1"
    label="~/${repo#$HOME/}"
    (( total++ ))

    branch=$(git -C "$repo" branch --show-current 2> /dev/null)
    if [[ -z "$branch" ]]; then
        local head_hash
        head_hash=$(git -C "$repo" rev-parse --short HEAD 2> /dev/null)
        if [[ -n "$head_hash" ]]; then
            branch="detached@$head_hash"
        fi
    fi

    # Follow the checked-out branch's upstream rather than guessing a remote
    # or switching branches. An unavailable upstream is reported as a skip;
    # this probe does not distinguish missing configuration from other errors.
    if ! git -C "$repo" rev-parse --abbrev-ref '@{upstream}' &> /dev/null; then
        (( skipped++ ))
        repo_status="SKIPPED"
        reason="no upstream"
        if (( verbose )); then
            printf '%s\n' "[$repo_status] $label"
            [[ -n "$branch" ]] && printf '%s\n' "    Branch: $branch"
            printf '%s\n' "    Result: $reason"
            printf '%s\n' ""
        else
            if [[ -n "$branch" ]]; then
                printf '[%-7s] %-*s  %-20s  (%s)\n' "$repo_status" "$max_label_len" "$label" "$reason" "$branch"
            else
                printf '[%-7s] %-*s  %-20s\n' "$repo_status" "$max_label_len" "$label" "$reason"
            fi
        fi
        return
    fi

    if (( progress )); then
        if [[ -n "$branch" ]]; then
            printf '\r\033[K[%-7s] %s (%s)' "FETCH" "$label" "$branch"
        else
            printf '\r\033[K[%-7s] %s' "FETCH" "$label"
        fi
    fi

    # A pipe needs a record terminator for the dispatcher's line reader;
    # direct terminal output keeps the existing in-place display.
    if (( progress )) && [[ ! -t 1 ]]; then
        printf '\n'
    fi

    # Determine success from Git's status and change from HEAD movement.
    # Capturing output keeps per-repository results together; --ff-only avoids
    # creating a merge commit for diverged branches, but does not bypass config.
    before=$(git -C "$repo" rev-parse HEAD 2> /dev/null)
    pull_output=$(GIT_TERMINAL_PROMPT=0 git -C "$repo" pull --ff-only 2>&1)
    pull_status=$?
    pull_output=${pull_output//$'\r'/}
    after=$(git -C "$repo" rev-parse HEAD 2> /dev/null)

    if (( progress )); then
        printf '\r\033[K'
    fi

    # Keep branch movement, pull result, warnings, and the one-line stat;
    # omit object transfer progress and the long per-file listing. These are
    # best-effort text filters, not a structured Git API; new wording may need
    # updates. A failure uses full output only if no filtered details survive.
    details=$(printf '%s\n' "$pull_output" | sed -n -E \
        -e '/^From /p' \
        -e '/^[[:space:]]*[+*]?[[:space:]]*[0-9a-f]+\.\.[0-9a-f]+[[:space:]]/p' \
        -e '/^(Updating [0-9a-zA-Z]|Fast-forward$|Already up[- ]to[- ]date\.$|Successfully rebased|Created autostash|Applied autostash\.|[[:space:]]*[0-9,]+ files? changed|CONFLICT|error:|fatal:|warning:)/p')

    forced_update=0
    autostash=0
    [[ "$pull_output" == *"(forced update)"* ]] && forced_update=1
    [[ "$pull_output" == *"Created autostash"* ]] && autostash=1

    if (( pull_status != 0 )); then
        repo_status="FAILED"
        reason="git pull failed (exit $pull_status)"
        details="${details:-$pull_output}"
        (( failed++ ))
    elif [[ "$before" != "$after" ]]; then
        repo_status="UPDATED"
        (( updated++ ))
        if [[ "$pull_output" == *"Successfully rebased"* ]]; then
            reason="rebased"
        elif [[ "$pull_output" == *"Fast-forward"* ]]; then
            reason="fast-forward"
        else
            reason="updated"
        fi
    else
        repo_status="CURRENT"
        reason="already up to date"
        (( current++ ))
    fi

    # Count warning categories, not repositories: one repository may increment
    # several categories. These annotations do not determine the exit status.
    if (( forced_update )); then
        reason+="; remote forced update"
        (( warnings++ ))
    fi
    if (( autostash )); then
        if [[ "$pull_output" == *"Applied autostash."* ]]; then
            reason+="; local changes restored"
        else
            reason+="; autostash needs attention"
            (( warnings++ ))
        fi
    fi
    if [[ "$pull_output" == *"warning:"* ]]; then
        reason+="; git warning"
        (( warnings++ ))
    fi

    if (( verbose )); then
        printf '%s\n' "[$repo_status] $label"
        [[ -n "$branch" ]] && printf '%s\n' "    Branch: $branch"
        printf '%s\n' "    Result: $reason"
        if [[ -n "$details" ]]; then
            while IFS= read -r line; do
                [[ -n "$line" ]] && printf '%s\n' "    $line"
            done <<< "$details"
        fi
        printf '%s\n' ""
    else
        if [[ -n "$branch" ]]; then
            printf '[%-7s] %-*s  %-20s  (%s)\n' "$repo_status" "$max_label_len" "$label" "$reason" "$branch"
        else
            printf '[%-7s] %-*s  %-20s\n' "$repo_status" "$max_label_len" "$label" "$reason"
        fi
        if [[ "$repo_status" == "FAILED" && -n "$details" ]]; then
            while IFS= read -r line; do
                [[ -n "$line" ]] && printf '%s\n' "    $line"
            done <<< "$details"
        fi
    fi
}

# The current layout scans direct children only, including hidden paths,
# directory symlinks, and linked worktrees (.git files). No canonical-path
# deduplication is performed, so aliases can pull the same checkout twice.
# nullglob avoids treating an unmatched pattern as a repository candidate.
shopt -s nullglob dotglob
repos=()
for repo in "$HOME"/* "$HOME"/repos/*; do
    [[ -d "$repo" && ( -d "$repo/.git" || -f "$repo/.git" ) ]] && repos+=("$repo")
done

# Calculate maximum label width dynamically for clean column alignment
for repo in "${repos[@]}"; do
    declare l="~/${repo#$HOME/}"
    (( ${#l} > max_label_len )) && max_label_len=${#l}
done

for repo in "${repos[@]}"; do
    __gpa_pull "$repo"
done


declare updated_text="$updated updated" current_text="$current current"
declare failed_text="$failed failed" warning_text="$warnings warnings"
declare first_width=${#updated_text}
(( ${#failed_text} > first_width )) && first_width=${#failed_text}
# Pad before adding ANSI colors so escape sequences do not affect alignment.
printf -v updated_text '%-*s' "$first_width" "$updated_text"
printf -v failed_text '%-*s' "$first_width" "$failed_text"
(( failed > 0 )) && failed_text="${color_red}${failed_text}${color_reset}"
(( warnings > 0 )) && warning_text="${color_yellow}${warning_text}${color_reset}"

# Verbose repo blocks already end with a blank line.
(( ! verbose || total == 0 )) && printf '%s\n' ""
printf 'gpa summary: %d repos\n' "$total"
printf '    %s | %s | %d skipped\n' "$updated_text" "$current_text" "$skipped"
printf '    %s | %s\n' "$failed_text" "$warning_text"

(( failed == 0 ))

}

main "$@"
